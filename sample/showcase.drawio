<mxfile>
  <!-- Original sample layout; AWS shape geometry is supplied by the extension. -->
  <diagram name="AWSの構成図">
    <mxGraphModel><root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="user" value="Client" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172554" vertex="1" parent="1">
        <mxGeometry x="20" y="30" width="140" height="60" as="geometry"/>
      </mxCell>
      <mxCell id="ec2" value="Amazon EC2" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ed7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top" vertex="1" parent="1">
        <mxGeometry x="230" y="20" width="80" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="storage" value="Data" style="shape=cylinder;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#14532d" vertex="1" parent="1">
        <mxGeometry x="390" y="20" width="120" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="e1" edge="1" parent="1" source="user" target="ec2"><mxGeometry as="geometry"/></mxCell>
      <mxCell id="e2" edge="1" parent="1" source="ec2" target="storage"><mxGeometry as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram name="基本図形">
    <mxGraphModel><root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="start" value="Start" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#14532d" vertex="1" parent="1">
        <mxGeometry x="20" y="35" width="120" height="60" as="geometry"/>
      </mxCell>
      <mxCell id="decision" value="Ready?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#713f12" vertex="1" parent="1">
        <mxGeometry x="210" y="15" width="120" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="end" value="Save" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172554" vertex="1" parent="1">
        <mxGeometry x="400" y="35" width="120" height="60" as="geometry"/>
      </mxCell>
      <mxCell id="e1" edge="1" parent="1" source="start" target="decision"><mxGeometry as="geometry"/></mxCell>
      <mxCell id="e2" value="Yes" edge="1" parent="1" source="decision" target="end"><mxGeometry as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
