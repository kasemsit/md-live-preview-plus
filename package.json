{
  "name": "markdown-live-preview-editor-claude",
  "displayName": "Markdown Live Preview Editor (Plus)",
  "description": "md-live-preview-plus: wikilinks with completion, callouts, footnotes, tables in quotes, and Claude Code sees the selected text. Edit the preview itself, Obsidian-style — with Mermaid and draw.io diagrams rendered inline. The only VS Code Markdown editor that draws .drawio files.",
  "version": "0.4.7",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/icon-128.png",
  "keywords": [
    "markdown",
    "markdown editor",
    "markdown preview",
    "live preview",
    "wysiwyg",
    "obsidian",
    "note taking",
    "notes",
    "mermaid",
    "preview",
    "css theme",
    "editor",
    "drawio",
    "draw.io",
    "diagrams.net",
    "diagram",
    "architecture diagram",
    "markdown live preview",
    "markdown wysiwyg",
    "wysiwyg editor",
    "typora",
    "zettelkasten",
    "knowledge base",
    "documentation",
    "readme",
    "writing",
    "katex"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kasemsit/md-live-preview-plus.git"
  },
  "bugs": {
    "url": "https://github.com/kasemsit/md-live-preview-plus/issues"
  },
  "homepage": "https://github.com/kasemsit/md-live-preview-plus#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdLivePreview.editor",
        "displayName": "Markdown Live Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdLivePreview",
          "title": "Markdown Live Preview Editor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mdLivePreview": [
        {
          "id": "mdLivePreview.outline",
          "name": "%view.outline%",
          "type": "webview"
        },
        {
          "id": "mdLivePreview.plus.backlinks",
          "name": "Backlinks"
        },
        {
          "id": "mdLivePreview.styleManager",
          "name": "%view.styleManager%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mdLivePreview.openWithLivePreview",
        "title": "%command.openWithLivePreview%",
        "category": "Markdown Live Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdLivePreview.openWithSource",
        "title": "%command.openWithSource%",
        "category": "Markdown Live Preview",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdLivePreview.newStyle",
        "title": "%command.newStyle%",
        "category": "Markdown Live Preview",
        "icon": "$(add)"
      },
      {
        "command": "mdLivePreview.plus.insertFootnote",
        "title": "Insert Footnote",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.clearClaudeSelection",
        "title": "Stop Sending the Selection to Claude",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.refreshBacklinks",
        "title": "Refresh Backlinks",
        "category": "Markdown Live Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "mdLivePreview.plus.openAt",
        "title": "Open Backlink",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.askClaude",
        "title": "Ask Claude About the Selection",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.copyRichText",
        "title": "Copy as Rich Text",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.copyBlockLink",
        "title": "Copy Link to This Block",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.copyTex",
        "title": "Copy TeX",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.copyTsv",
        "title": "Copy Table as Tab-Separated Text",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.openLinkBeside",
        "title": "Open Link to the Side",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.openAsTextHere",
        "title": "Open as Text at This Line",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.openInObsidian",
        "title": "Open in Obsidian",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.addReviewComment",
        "title": "Add REVIEW Comment",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.renumberFootnotes",
        "title": "Renumber Footnotes in Order",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.insertRowAbove",
        "title": "Insert Row Above",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.insertRowBelow",
        "title": "Insert Row Below",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.insertColumnLeft",
        "title": "Insert Column Left",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.insertColumnRight",
        "title": "Insert Column Right",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.deleteRow",
        "title": "Delete Row",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.deleteColumn",
        "title": "Delete Column",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.sortAscending",
        "title": "Sort Table by This Column (A→Z)",
        "category": "Markdown Live Preview"
      },
      {
        "command": "mdLivePreview.plus.table.sortDescending",
        "title": "Sort Table by This Column (Z→A)",
        "category": "Markdown Live Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdLivePreview.openWithLivePreview",
          "when": "resourceLangId == markdown && activeCustomEditorId != mdLivePreview.editor",
          "group": "navigation"
        },
        {
          "command": "mdLivePreview.openWithSource",
          "when": "activeCustomEditorId == mdLivePreview.editor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mdLivePreview.newStyle",
          "when": "view == mdLivePreview.styleManager",
          "group": "navigation"
        },
        {
          "command": "mdLivePreview.plus.refreshBacklinks",
          "when": "view == mdLivePreview.plus.backlinks",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdLivePreview.plus.openAt",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.askClaude",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.copyRichText",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.copyBlockLink",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.copyTex",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.copyTsv",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.openLinkBeside",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.openAsTextHere",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.openInObsidian",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.addReviewComment",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.renumberFootnotes",
          "when": "activeCustomEditorId == mdLivePreview.editor"
        },
        {
          "command": "mdLivePreview.plus.table.insertRowAbove",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.insertRowBelow",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.insertColumnLeft",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.insertColumnRight",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.deleteRow",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.deleteColumn",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.sortAscending",
          "when": "false"
        },
        {
          "command": "mdLivePreview.plus.table.sortDescending",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "mdLivePreview.plus.askClaude",
          "when": "webviewId == 'mdLivePreview.editor' && mlpHasSelection",
          "group": "1_plus_claude@1"
        },
        {
          "command": "mdLivePreview.plus.copyRichText",
          "when": "webviewId == 'mdLivePreview.editor'",
          "group": "2_plus_copy@1"
        },
        {
          "command": "mdLivePreview.plus.copyBlockLink",
          "when": "webviewId == 'mdLivePreview.editor'",
          "group": "2_plus_copy@2"
        },
        {
          "command": "mdLivePreview.plus.copyTex",
          "when": "webviewId == 'mdLivePreview.editor' && mlpMath",
          "group": "2_plus_copy@3"
        },
        {
          "command": "mdLivePreview.plus.table.copyTsv",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "2_plus_copy@4"
        },
        {
          "command": "mdLivePreview.plus.openLinkBeside",
          "when": "webviewId == 'mdLivePreview.editor' && mlpLink",
          "group": "3_plus_open@1"
        },
        {
          "command": "mdLivePreview.plus.openAsTextHere",
          "when": "webviewId == 'mdLivePreview.editor'",
          "group": "3_plus_open@2"
        },
        {
          "command": "mdLivePreview.plus.openInObsidian",
          "when": "webviewId == 'mdLivePreview.editor'",
          "group": "3_plus_open@3"
        },
        {
          "command": "mdLivePreview.plus.addReviewComment",
          "when": "webviewId == 'mdLivePreview.editor'",
          "group": "4_plus_edit@1"
        },
        {
          "command": "mdLivePreview.plus.renumberFootnotes",
          "when": "webviewId == 'mdLivePreview.editor' && mlpHasFootnotes",
          "group": "4_plus_edit@2"
        },
        {
          "command": "mdLivePreview.plus.table.insertRowAbove",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@1"
        },
        {
          "command": "mdLivePreview.plus.table.insertRowBelow",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@2"
        },
        {
          "command": "mdLivePreview.plus.table.insertColumnLeft",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@3"
        },
        {
          "command": "mdLivePreview.plus.table.insertColumnRight",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@4"
        },
        {
          "command": "mdLivePreview.plus.table.deleteRow",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@5"
        },
        {
          "command": "mdLivePreview.plus.table.deleteColumn",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@6"
        },
        {
          "command": "mdLivePreview.plus.table.sortAscending",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@7"
        },
        {
          "command": "mdLivePreview.plus.table.sortDescending",
          "when": "webviewId == 'mdLivePreview.editor' && mlpTable",
          "group": "5_plus_table@8"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Live Preview",
      "properties": {
        "mdLivePreview.codeTheme": {
          "type": "string",
          "enum": [
            "auto",
            "dark-plus",
            "light-plus",
            "github-dark",
            "github-light"
          ],
          "enumDescriptions": [
            "%config.codeTheme.auto%",
            "%config.codeTheme.darkPlus%",
            "%config.codeTheme.lightPlus%",
            "%config.codeTheme.githubDark%",
            "%config.codeTheme.githubLight%"
          ],
          "default": "auto",
          "description": "%config.codeTheme%"
        },
        "mdLivePreview.enabledStyles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "%config.enabledStyles%"
        },
        "mdLivePreview.defaultEditor": {
          "type": "string",
          "enum": [
            "prompt",
            "livePreview",
            "default"
          ],
          "enumDescriptions": [
            "%config.defaultEditor.prompt%",
            "%config.defaultEditor.livePreview%",
            "%config.defaultEditor.default%"
          ],
          "default": "prompt",
          "description": "%config.defaultEditor%"
        },
        "mdLivePreview.plus.shareSelectionWithClaude": {
          "type": "boolean",
          "default": true,
          "description": "md-live-preview-plus: write the text selected in the Live Preview to ~/.claude/live-preview-selection.json (only if ~/.claude exists), where the bundled Claude Code hook passes it to Claude."
        },
        "mdLivePreview.plus.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "md-live-preview-plus: once a day, check GitHub Releases (api.github.com) for a newer version and offer the download page."
        }
      }
    },
    "keybindings": [
      {
        "command": "mdLivePreview.plus.insertFootnote",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeCustomEditorId == mdLivePreview.editor"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:integration": "tsc -p tsconfig.test.json && vscode-test",
    "test:e2e": "playwright test",
    "test:all": "npm run test:coverage && npm run test:integration && npm run test:e2e",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit -p tsconfig.json --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "fast-check": "^4.9.0",
    "mocha": "^12.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.3.2",
    "@shikijs/core": "^1.24.0",
    "@shikijs/engine-javascript": "^1.24.0",
    "@shikijs/langs": "^1.24.0",
    "@shikijs/themes": "^1.24.0",
    "katex": "^0.16.47",
    "mermaid": "^11.4.1",
    "yaml": "^2.9.0"
  }
}
